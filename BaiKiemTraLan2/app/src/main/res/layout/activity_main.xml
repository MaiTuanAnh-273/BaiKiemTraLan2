<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSinhVien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ tên: Mai Tuấn Anh&#10;Mã sinh viên: 2415141122125&#10;Lớp HP: 126TLTTD01"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ CÔNG VIỆC"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtTenCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên công việc"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập mô tả công việc"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <Button
            android:id="@+id/btnTaoCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo công việc" />

        <Button
            android:id="@+id/btnXemDanhSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem danh sách công việc" />

    </LinearLayout>
</ScrollView>
